# Скопіюйте в .env і заповніть. Файл .env не комітиться.
# Значення нижче — для локального запуску. Що змінити на staging і production — docs/operations.md.
# [секрет] — не комітити, не пересилати в месенджерах, на сервері права на .env лише для власника (chmod 600).

# --- Compose на сервері ------------------------------------------------------------
# Тоді команди скорочуються до «docker compose up -d» без -f і --profile.
# Production:
#COMPOSE_FILE=compose.yaml:deploy/compose.production.yaml
#COMPOSE_PROFILES=app,offsite
# Staging (окремий каталог з окремим .env):
#COMPOSE_FILE=compose.yaml:compose.staging.yaml
#COMPOSE_PROFILES=app
# Тег образів: відкат — повернути попереднє значення й виконати «docker compose up -d».
APP_VERSION=latest

# --- Середовище ----------------------------------------------------------------------
# Production | Staging | Development (staging задає Staging сам)
APP_ENVIRONMENT=Production
# Демо-товари для локальної перевірки вітрини (на staging і production — false)
SEED_DEMO_DATA=true
# Опис API на /api/openapi/v1.json і Scalar на /api/docs (на production — false)
EXPOSE_API_DOCS=true

# --- PostgreSQL ----------------------------------------------------------------------
# [секрет] На сервері — довгий випадковий пароль. Змінюється лише до першого запуску бази.
POSTGRES_PASSWORD=polivalko_dev
# Публікація порту БД для локальних інструментів (на production порт не публікується)
POSTGRES_BIND=127.0.0.1
POSTGRES_PORT=5432

# --- Адреса сайту й HTTPS ------------------------------------------------------------
# Caddy: ":8080" локально або домен (example.ua) — тоді сертифікат HTTPS отримується автоматично
SITE_ADDRESS=:8080
# Порт вітрини локально й на staging (production публікує 80 і 443)
HTTP_PORT=8080
# Лише staging: адреса, на якій слухає порт (127.0.0.1 — доступ через SSH-тунель)
#HTTP_BIND=127.0.0.1
# Публічна адреса магазину: посилання повернення з оплати, вебхуки, sitemap, canonical
SITE_URL=http://localhost:8080
# index | noindex — заголовок X-Robots-Tag (staging завжди noindex)
SEARCH_INDEXING=index

# --- Вітрина (Next.js) ---------------------------------------------------------------
# [секрет] Спільний секрет скидання кешу вітрини (API і Worker → web /internal/revalidate)
REVALIDATE_SECRET=local-revalidate-secret
# Google Analytics 4 і верифікація Search Console. Вбудовуються під час збірки образу web.
GA_MEASUREMENT_ID=
GSC_VERIFICATION=

# --- Перший адміністратор ------------------------------------------------------------
# Створюється під час старту API, якщо такого email ще немає. Пароль: від 10 символів, великі
# й малі літери, цифра і спецсимвол. Після першого входу пароль звідси приберіть.
ADMIN_EMAIL=
# [секрет]
ADMIN_PASSWORD=

# --- Продавець (оферта, чеки, листи) -------------------------------------------------
SELLER_NAME=Продавець уточнюється
# ЄДРПОУ або РНОКПП
SELLER_TAX_ID=
SELLER_ADDRESS=

# --- Navkolo (ERP) -------------------------------------------------------------------
# Disabled | Stub (до отримання доступу до API Navkolo)
NAVKOLO_MODE=Stub
# Період синхронізації цін і залишків, ГГ:ХХ:СС
NAVKOLO_SYNC_INTERVAL=00:05:00

# --- Оплата --------------------------------------------------------------------------
# Sandbox — тестова оплата без провайдера | Mono — Plata by mono
PAYMENTS_PROVIDER=Sandbox
# [секрет] Підпис тестових оплат (Sandbox). На сервері — випадковий рядок.
PAYMENTS_SANDBOX_SECRET=local-sandbox-secret
# [секрет] Токен Plata by mono (для Mono)
MONO_TOKEN=
# Лише staging: справжній провайдер вмикається тут, а не через PAYMENTS_PROVIDER
#STAGING_PAYMENTS_PROVIDER=Sandbox

# --- Фіскалізація --------------------------------------------------------------------
# Disabled | Stub | Checkbox
FISCAL_PROVIDER=Stub
# [секрет] Ключ ліцензії каси й облікові дані касира Checkbox
CHECKBOX_LICENSE_KEY=
CHECKBOX_CASHIER_LOGIN=
CHECKBOX_CASHIER_PASSWORD=
# Лише staging: Checkbox на staging вмикається тут (тестова каса!)
#STAGING_FISCAL_PROVIDER=Stub

# --- Нова пошта ----------------------------------------------------------------------
# [секрет] Ключ API 2.0; порожньо — демонстраційний довідник
NOVAPOSHTA_API_KEY=

# --- Повідомлення й тривоги в Telegram -----------------------------------------------
# Нові замовлення й заявки менеджеру, збої інтеграцій. Порожньо — лише запис у лог.
# [секрет]
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Резервні копії ------------------------------------------------------------------
# Щоденний дамп о цій годині за Києвом (уникайте 03:00–03:59: перехід на літній час)
BACKUP_TIME=02:30
# Скільки днів зберігати дампи на сервері
BACKUP_RETENTION_DAYS=14
# Іменований том (backups) або шлях на хості, напр. /srv/polivalko-backups на окремому диску
BACKUP_PATH=backups

# --- Копія бекапів поза сервер (профіль compose «offsite») ---------------------------
# Бакет і шлях у S3-сумісному сховищі, напр. polivalko-backups/production
OFFSITE_TARGET=
# Провайдер rclone: AWS, Cloudflare, Hetzner, Wasabi, Minio, Other …
OFFSITE_S3_PROVIDER=Other
OFFSITE_S3_ENDPOINT=
OFFSITE_S3_REGION=
# [секрет] Ключ лише з правом запису в бакет
OFFSITE_S3_ACCESS_KEY_ID=
OFFSITE_S3_SECRET_ACCESS_KEY=
# Як часто перевіряти нові дампи, с
OFFSITE_INTERVAL=3600
# Порожньо — строк зберігання задає правило життєвого циклу бакета (рекомендовано)
OFFSITE_RETENTION_DAYS=
