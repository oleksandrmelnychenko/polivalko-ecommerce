{
	admin off
	auto_https off
}

:3000 {
	root * /srv
	encode zstd gzip

	@assets {
		path /_next/static/*
		file
	}
	header @assets Cache-Control "public, max-age=31536000, immutable"

	@pages not path /_next/static/*
	header @pages Cache-Control "no-cache"

	@spa {
		not path /_next/static/*
		not file
	}
	rewrite @spa /index.html
	file_server
}
