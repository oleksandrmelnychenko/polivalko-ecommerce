{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "--project",
        "src/PoliValko.Api",
        "--launch-profile",
        "http"
      ],
      "port": 5080
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "shop-docker-api",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "set API_INTERNAL_URL=http://localhost:8080&& npm --prefix web/apps/shop run dev"
      ],
      "port": 3000
    }
  ]
}
